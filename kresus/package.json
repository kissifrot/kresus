{
  "name": "kresus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:performance": "vitest run --config vitest.performance.config.ts --reporter=verbose",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons": "node scripts/generate-icons.mjs",
    "test:e2e": "node e2e/tauri-smoke.mjs",
    "format": "prettier --no-error-on-unmatched-pattern --write \"src/**/*.{ts,css}\" \"tests/**/*.ts\" \"benchmarks/**/*.ts\" \"e2e/**/*.mjs\" \"scripts/money-prototype/*.ts\" \"*.ts\" \"*.html\" && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --no-error-on-unmatched-pattern --check \"src/**/*.{ts,css}\" \"tests/**/*.ts\" \"benchmarks/**/*.ts\" \"e2e/**/*.mjs\" \"scripts/money-prototype/*.ts\" \"*.ts\" \"*.html\" && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "test:e2e:native": "node e2e/native-dialogs.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "buffer": "6.0.3",
    "create-hash": "1.2.0",
    "events": "3.3.0",
    "mdb-reader": "3.2.0",
    "process": "0.11.10",
    "stream-browserify": "3.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  }
}
