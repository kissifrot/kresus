# SQLite databases and their sidecar files can contain private financial data.
*.db
*.db-journal
*.db-wal
*.db-shm
*.db3
*.db3-journal
*.db3-wal
*.db3-shm
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Kresus databases and SQLite sidecars can contain private financial data.
*.kresus
*.kresus-journal
*.kresus-wal
*.kresus-shm

# Microsoft Money source and backup files may contain private financial data.
*.mny
*.MNY
*.mbf
*.MBF

# One reviewed fictional Money file is a versioned test fixture.
!/kresus/tests/fixtures/money-reference.mny

# Python bytecode generated by local tests.
__pycache__/
*.py[cod]
